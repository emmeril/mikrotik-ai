[modules]
log_file
chap-secrets
sstp
auth_mschap_v2
auth_mschap_v1
auth_pap

[core]
log-error=/var/log/accel-ppp/core.log
thread-count=2

[ppp]
mtu=1400
mru=1400
mppe=require
ipv4=require
ipv6=deny
lcp-echo-interval=20
lcp-echo-timeout=120

[sstp]
bind=0.0.0.0
port=443
accept=ssl
ssl-protocol=tls1.2,tls1.3
ssl-pemfile=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
ssl-keyfile=/etc/letsencrypt/live/vpn.example.com/privkey.pem
host-name=vpn.example.com

[chap-secrets]
gw-ip-address=10.90.0.1
chap-secrets=/var/lib/mikrotik-ai/chap-secrets
encrypted=0

[log]
log-file=/var/log/accel-ppp/accel-ppp.log
level=3
